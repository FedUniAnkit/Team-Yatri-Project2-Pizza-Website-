<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Order #<%= orderNumber %> Update - Komorebi Pizza</title>
  <style>
    body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 600px; margin: 0 auto; padding: 20px; background: #f9f9f9; }
    .card { background: #fff; border-radius: 10px; padding: 30px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
    .header { text-align: center; margin-bottom: 24px; }
    .logo { font-size: 1.8rem; font-weight: 700; color: #e74c3c; margin-bottom: 4px; }
    .status-badge {
      display: inline-block; padding: 8px 20px; border-radius: 20px;
      font-size: 1rem; font-weight: 700; color: #fff; margin: 12px 0;
      background: <%= status === 'Confirmed' ? '#27ae60' : status === 'Cancelled' ? '#e74c3c' : '#3498db' %>;
    }
    .detail-row { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #f0f0f0; }
    .detail-row:last-child { border-bottom: none; }
    .detail-label { color: #7f8c8d; font-size: 0.9rem; }
    .detail-value { font-weight: 600; color: #2c3e50; font-size: 0.9rem; }
    .message-box {
      background: #f8f9fa; border-left: 4px solid <%= status === 'Confirmed' ? '#27ae60' : '#e74c3c' %>;
      padding: 14px 16px; border-radius: 0 8px 8px 0; margin: 20px 0;
      font-size: 0.95rem; color: #555;
    }
    .footer { text-align: center; margin-top: 24px; font-size: 0.8rem; color: #aaa; }
    .footer a { color: #e74c3c; text-decoration: none; }
  </style>
</head>
<body>
  <div class="card">
    <div class="header">
      <div class="logo">🍕 Komorebi Pizza</div>
      <p style="color:#7f8c8d;margin:0;">Order Status Update</p>
      <div class="status-badge"><%= status %></div>
    </div>

    <p>Hi <strong><%= name %></strong>,</p>

    <div class="message-box"><%= statusMessage %></div>

    <div style="background:#f8f9fa;border-radius:8px;padding:16px;margin:16px 0;">
      <div class="detail-row">
        <span class="detail-label">Order Number</span>
        <span class="detail-value">#<%= orderNumber %></span>
      </div>
      <div class="detail-row">
        <span class="detail-label">Status</span>
        <span class="detail-value"><%= status %></span>
      </div>
      <div class="detail-row">
        <span class="detail-label">Order Total</span>
        <span class="detail-value">$<%= orderTotal %></span>
      </div>
    </div>

    <p style="color:#7f8c8d;font-size:0.9rem;">If you have any questions, please contact us.</p>
    <p>Thank you for choosing <strong>Komorebi Pizza</strong>!</p>
  </div>

  <div class="footer">
    <p>© <%= new Date().getFullYear() %> Komorebi Pizza. All rights reserved.</p>
  </div>
</body>
</html>
